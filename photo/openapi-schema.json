  /api/v1/auth/login/:
    post:
      operationId: api_v1_auth_login_create
      description: 'Authentifie un administrateur à l''aide de son email (ex: admin@clovis-dev.bf)
        et retourne les tokens access & refresh.'
      summary: Connexion JWT (email ou username)
      tags:
      - Authentification
      requestBody:
