          description: ''
  /api/v1/participants/:
    post:
      operationId: api_v1_participants_create
      description: |-
        Enregistre un participant ou retourne son profil s'il existe déjà grâce à son numéro WhatsApp (`phone`).
        Retourne l'ID unique requis pour les interactions suivantes.
      summary: Identifier ou enregistrer un participant (Login / Upsert)
      tags:
      - Participants
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ParticipantRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ParticipantRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ParticipantRequest'
        required: true
      security:
      - jwtAuth: []
      - cookieAuth: []
      - {}
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Participant'
          description: ''
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Participant'
          description: ''
        '400':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/v1/participants/{id}/:
    delete:
      operationId: api_v1_participants_destroy
      description: Supprime définitivement le participant ainsi que toutes ses données
        et associations.
      summary: Droit à l'oubli intégral (RGPD)
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - Participants
      security:
      - jwtAuth: []
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/v1/participants/{id}/face-reference/:
    post:
      operationId: api_v1_participants_face_reference_create
      description: |-
        Reçoit le selfie de référence du participant (JPEG ou PNG via champ `file`).
        1. Vérifie la qualité (taille >= 200x200, netteté >= 50, 1 seul visage centré).
        2. Extrait l'embedding 512 dimensions InsightFace.
        3. **Supprime immédiatement l'image brute (conformité RGPD)**.
        4. Déclenche le matching asynchrone sur l'événement (`?event={slug}`).
      summary: Uploader le selfie de référence
      parameters:
      - in: query
        name: event
        schema:
          type: string
        description: Slug de l'événement concerné pour le matching ciblé
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - Participants
      requestBody:
        content:
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/SingleFileUploadRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/SingleFileUploadRequest'
        required: true
      security:
      - jwtAuth: []
      - cookieAuth: []
      - {}
      responses:
        '202':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
        '400':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
    delete:
      operationId: api_v1_participants_face_reference_destroy
      description: Supprime l'embedding facial du participant et réinitialise son
        statut à 'no_reference'.
      summary: Supprimer la référence faciale (RGPD)
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - Participants
      security:
      - jwtAuth: []
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
