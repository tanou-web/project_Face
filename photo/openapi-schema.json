          description: ''
  /api/v1/events/:
    get:
      operationId: api_v1_events_list
      description: Retourne la liste des événements ordonnés par date décroissante
        (optimisé SQL sans N+1).
      summary: Lister tous les événements publics
      tags:
      - Événements
      security:
      - jwtAuth: []
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/EventList'
          description: ''
  /api/v1/events/{slug}/:
    get:
      operationId: api_v1_events_retrieve
      description: Récupère la fiche détaillée d'un événement avec sa galerie de photos
        et sa vidéo.
      summary: Détail d'un événement
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - Événements
      security:
      - jwtAuth: []
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/EventDetail'
          description: ''
    patch:
      operationId: api_v1_events_partial_update
      description: Permet à l'organisateur / admin de modifier les informations d'un
        événement.
      summary: Mise à jour partielle d'un événement
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - Administration
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedEventPatchRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedEventPatchRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedEventPatchRequest'
      security:
      - jwtAuth: []
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/EventDetail'
          description: ''
  /api/v1/events/{slug}/my-photos/:
    get:
      operationId: api_v1_events_my_photos_retrieve
      description: |-
        Retourne les photos reconnues pour un participant donné sur un événement.
        Prend en charge `?participant={id}` ou `?phone={numéro WhatsApp}` pour garantir le bon fonctionnement même lorsque le frontend n'a pas encore persisté l'identifiant.
      summary: Photos matchées du participant
      parameters:
      - in: query
        name: participant
        schema:
          type: integer
        description: ID unique du participant retourné lors du POST /participants/
      - in: query
        name: phone
        schema:
          type: string
        description: 'Numéro WhatsApp du participant (ex: ''+226 70123456'')'
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - Participants
      security:
      - jwtAuth: []
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MyPhotosResponse'
          description: ''
  /api/v1/events/{slug}/photos/:
