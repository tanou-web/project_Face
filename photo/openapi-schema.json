openapi: 3.0.3
info:
  title: Plateforme Photo Scan API
  version: 1.0.0
  description: |-
    Documentation interactive de l'API backend Django REST Framework pour la plateforme événementielle avec reconnaissance faciale (Burkina Faso).

    Fonctionnalités principales :
    - Gestion des événements et galeries médias
    - Upsert des participants via numéro WhatsApp
    - Ingestion sécurisée de selfie de référence & matching facial 512D
    - Endpoints RGPD de suppression et droit à l'oubli
    - Administration sécurisée via token JWT
paths:
  /admin/contacts/:
    get:
      operationId: admin_contacts_retrieve
      description: Récupère les coordonnées des participants et indique si leur référence
        faciale est valide.
      summary: Liste des contacts participants
      parameters:
      - in: query
        name: event
        schema:
          type: string
        description: Filtrer les participants par slug d'événement
      tags:
      - Administration
      security:
      - jwtAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /admin/events/{slug}/logo/:
    post:
      operationId: admin_events_logo_create
      description: Upload d'un logo (champ `file`) et mise à jour de l'événement.
      summary: Upload de logo pour un événement
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - Administration
      requestBody:
        content:
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/SingleFileUploadRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/SingleFileUploadRequest'
        required: true
      security:
      - jwtAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
        '400':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /admin/events/{slug}/media/:
    post:
      operationId: admin_events_media_create
      description: |-
        Téléversement d'une ou plusieurs photos pour un événement (champ `files`).
        Pour chaque fichier :
        1. Enregistre le média original.
        2. Crée la miniature Pillow (400x400 max) avec correction EXIF.
        3. Détecte tous les visages et génère les embeddings 512D (`FaceIndex`).
        4. Actualise automatiquement le matching pour les participants déjà inscrits.
      summary: Upload multiple de photos avec indexation faciale
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - Administration
      requestBody:
        content:
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/MultiFileUploadRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/MultiFileUploadRequest'
        required: true
      security:
      - jwtAuth: []
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
        '400':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /admin/media/{id}/:
    delete:
      operationId: admin_media_destroy
      description: Supprime la photo et tous ses index faciaux associés.
      summary: Suppression d'une photo
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - Administration
      security:
      - jwtAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /admin/stats/:
    get:
      operationId: admin_stats_retrieve
      description: Retourne le nombre total d'événements, photos, participants et
        téléchargements.
      summary: Statistiques globales
      tags:
      - Administration
      security:
      - jwtAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/v1/admin/contacts/:
    get:
      operationId: api_v1_admin_contacts_retrieve
      description: Récupère les coordonnées des participants et indique si leur référence
        faciale est valide.
      summary: Liste des contacts participants
      parameters:
      - in: query
        name: event
        schema:
          type: string
        description: Filtrer les participants par slug d'événement
      tags:
      - Administration
      security:
      - jwtAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/v1/admin/events/{slug}/logo/:
    post:
      operationId: api_v1_admin_events_logo_create
      description: Upload d'un logo (champ `file`) et mise à jour de l'événement.
